<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Junpro_Project</RootNamespace>
    <AssemblyName>NADI</AssemblyName>
    <!-- Ukuran kontrol ditulis dalam piksel 96 DPI; biarkan Windows yang
         menskalakan di layar 125%/150% agar teks tidak terpotong. -->
    <ApplicationHighDpiMode>DpiUnawareGdiScaled</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <!-- Connection string PostgreSQL dibaca dari appsettings.local.json di root
       repo (tidak di-commit, PRD §11.5); disalin ke folder output bila ada. -->
  <ItemGroup>
    <None Include="..\..\appsettings.local.json" Link="appsettings.local.json"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\appsettings.local.json')" />
  </ItemGroup>

</Project>
