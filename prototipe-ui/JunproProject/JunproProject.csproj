<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Junpro_Project</RootNamespace>
    <AssemblyName>NADI</AssemblyName>
    <ApplicationIcon>Resources\nadi.ico</ApplicationIcon>
    <!-- Ukuran kontrol ditulis dalam piksel 96 DPI; biarkan Windows yang
         menskalakan di layar 125%/150% agar teks tidak terpotong. -->
    <ApplicationHighDpiMode>DpiUnawareGdiScaled</ApplicationHighDpiMode>
    <Product>NADI - Nusantara Climate Data &amp; Insight</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <!-- Font Plus Jakarta Sans (SIL OFL 1.1, lihat Resources/Font/OFL.txt) ditanam di NADI.exe
       agar tampilan sama di komputer yang belum memasangnya (PRD §13). -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Font\PlusJakartaSans-Regular.ttf" LogicalName="font-regular" />
    <EmbeddedResource Include="Resources\Font\PlusJakartaSans-Bold.ttf" LogicalName="font-bold" />
  </ItemGroup>

  <!-- Connection string PostgreSQL dibaca dari appsettings.local.json di root
       repo (tidak di-commit, PRD §11.5); disalin ke folder output bila ada.
       Hanya untuk build Debug: paket Release tidak boleh membawa rahasia lokal
       (password database, API key) milik pengembang. -->
  <ItemGroup>
    <None Include="..\..\appsettings.local.json" Link="appsettings.local.json"
          CopyToOutputDirectory="PreserveNewest"
          Condition="'$(Configuration)' == 'Debug' And Exists('..\..\appsettings.local.json')" />
  </ItemGroup>

</Project>
